---
import { routes } from "../lib/navigation";
import { copy } from "../i18n";
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="ornament" aria-hidden="true">✦</span>
      <span>EXILE NEXUS</span>
      <p>{copy.footer.tagline}</p>
    </div>
    <nav aria-label={copy.common.footerNavigation} class="footer-links">
      <a href="/">{copy.common.home}</a>
      <a href="/search/">{copy.common.search}</a>
      {routes.slice(0, 4).map((route) => <a href={route.href}>{route.short}</a>)}
    </nav>
    <p class="disclaimer">{copy.footer.disclaimer}</p>
  </div>
</footer>
