---
import { routes, isCurrentPath } from "../lib/navigation";
import { MobileNav } from "./MobileNav";
import { copy } from "../i18n";

const { currentPath = "/" } = Astro.props as { currentPath?: string };
const featured = routes.slice(0, 5);
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand exn-focusable" href="/" aria-label={copy.common.brandHome}>
      <svg class="brand-prism" viewBox="0 0 72 72" role="img" aria-label={copy.common.brandSymbol}>
        <path d="M36 4 64 20 64 52 36 68 8 52 8 20Z" fill="#101116" stroke="#d6b478" stroke-width="2.4" />
        <path d="M36 14 54 25 54 47 36 58 18 47 18 25Z" fill="none" stroke="#e35a2d" stroke-width="2" />
        <path d="M36 17 48 36 36 55 24 36Z" fill="#792321" stroke="#f0d3a0" stroke-width="1.7" />
        <path d="M36 16v40M24 36h24" stroke="#f6ac72" stroke-width="1.2" />
      </svg>
      <span class="brand-type">EXILE <span>NEXUS</span><small>{copy.common.brandDescriptor}</small></span>
    </a>

    <nav class="desktop-nav" aria-label={copy.common.mainNavigation}>
      <a class:list={["header-link", { "is-current": isCurrentPath(currentPath, "/") }]} href="/" aria-current={isCurrentPath(currentPath, "/") ? "page" : undefined}>{copy.common.home}</a>
      {featured.map((route) => (
        <a class:list={["header-link", { "is-current": isCurrentPath(currentPath, route.href) }]} href={route.href} aria-current={isCurrentPath(currentPath, route.href) ? "page" : undefined}>{route.short}</a>
      ))}
      <div class="more-link"><a class:list={["header-link", { "is-current": ["/advisor/", "/guides/"].some((p) => isCurrentPath(currentPath, p)) }]} href="/guides/">{copy.common.guides}</a></div>
    </nav>

    <div class="header-actions">
      <a class="header-utility exn-focusable" href="/search/" aria-label={copy.common.openSearch} aria-current={isCurrentPath(currentPath, "/search/") ? "page" : undefined}>⌕ <span>{copy.common.search}</span></a>
      <a class="header-utility exn-focusable" href="/advisor/" aria-label={copy.common.exploreAdvisor}>✳ <span>{copy.common.advisor}</span></a>
      <MobileNav client:load currentPath={currentPath} />
    </div>
  </div>
</header>
