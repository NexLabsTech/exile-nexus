---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UiShowcase } from "../../components/ui/UiShowcase";
import "../../styles/ui-kit.css";
import { copy } from "../../i18n";
---
<BaseLayout
  title={copy.kitPage.title}
  description={copy.kitPage.description}
  currentPath="/ui-kit/"
  robots="noindex,nofollow"
>
  <section class="inner-hero" aria-labelledby="ui-kit-heading">
    <div class="inner-hero-art" aria-hidden="true"><span class="inner-hero-sigil">✦</span></div>
    <div class="inner-hero-content">
      <nav class="breadcrumbs" aria-label={copy.common.breadcrumb}>
        <a class="exn-focusable" href="/">{copy.common.home}</a><span aria-hidden="true">›</span>
        <span aria-current="page">{copy.kitPage.breadcrumb}</span>
      </nav>
      <p class="eyebrow">{copy.kitPage.eyebrow}</p>
      <h1 id="ui-kit-heading">{copy.kitPage.heading}</h1>
      <p>{copy.kitPage.lead}</p>
      <span class="ribbon-status"><span aria-hidden="true">✦</span> {copy.kitPage.ribbon}</span>
    </div>
  </section>
  <UiShowcase client:load />
</BaseLayout>
