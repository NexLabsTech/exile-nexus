---
import BaseLayout from "../layouts/BaseLayout.astro";
import { copy } from "../i18n";
---
<BaseLayout title={copy.lost.title} description={copy.lost.description} currentPath="/missing/">
  <section class="lost-page" aria-labelledby="lost-heading">
    <div class="lost-portal" aria-hidden="true"><span>✦</span></div>
    <p class="eyebrow">{copy.lost.eyebrow}</p>
    <h1 id="lost-heading">404</h1>
    <h2>{copy.lost.heading}</h2>
    <p>{copy.lost.body}</p>
    <a class="button button-primary exn-focusable" href="/">{copy.common.returnHome} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
