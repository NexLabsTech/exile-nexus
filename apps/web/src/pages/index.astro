---
import BaseLayout from "../layouts/BaseLayout.astro";
import { routes } from "../lib/navigation";
import { copy, formatMessage } from "../i18n";

const highlights = routes.slice(0, 6);
const quickLinks = routes.slice(0, 4);
---
<BaseLayout
  title={copy.home.title}
  description={copy.home.description}
  currentPath="/"
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-scene" aria-hidden="true">
      <div class="hero-moon"></div>
      <div class="hero-ruins"></div>
      <div class="hero-silhouette"></div>
      <div class="hero-flare"></div>
    </div>
    <div class="hero-content">
      <p class="eyebrow"><span class="eyebrow-diamond" aria-hidden="true">✦</span> {copy.home.eyebrow}</p>
      <h1 id="hero-heading">{copy.home.heroFirst}<br /><span>{copy.home.heroSecond}</span></h1>
      <p class="hero-lead">{copy.home.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary exn-focusable" href="/builds/"><span>{copy.home.primaryCta}</span><span aria-hidden="true">↗</span></a>
        <a class="button button-ghost exn-focusable" href="/items/">{copy.home.secondaryCta} <span aria-hidden="true">◇</span></a>
      </div>
      <p class="hero-status"><span class="status-dot" aria-hidden="true"></span> {copy.home.developmentStatus} <span class="hero-status-rule" aria-hidden="true"></span> {copy.home.visualPilot}</p>
    </div>
    <div class="hero-side-rail" aria-hidden="true"><span>{copy.home.rail}</span><span>✧</span></div>
  </section>

  <section class="quick-strip" aria-label={copy.home.quickNavigation}>
    {quickLinks.map((route) => (
      <a class="quick-item exn-focusable" href={route.href}>
        <span class="quick-glyph" aria-hidden="true">{route.mark}</span>
        <span class="quick-text"><strong>{route.label}</strong><small>{route.category}</small></span>
        <span class="quick-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>

  <section class="content-section" aria-labelledby="section-tools">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.home.sectionEyebrow}</p>
        <h2 id="section-tools">{copy.home.sectionPrefix} <em>{copy.home.sectionEmphasis}</em></h2>
      </div>
      <p>{copy.home.sectionLead}</p>
    </div>
    <div class="feature-grid">
      {highlights.map((route, index) => (
        <article class:list={["feature-card", { "feature-card-wide": index === 0 }]}>
          <a class="feature-card-link exn-focusable" href={route.href} aria-label={formatMessage(copy.home.featureLabel, { name: route.label })}>
            <div class="feature-card-art" aria-hidden="true">
              <span class="feature-card-ring"></span>
              <span class="feature-glyph">{route.mark}</span>
            </div>
            <div class="feature-card-body">
              <span class="feature-category">{route.category} <span> / 0{index + 1}</span></span>
              <h3>{route.label}</h3>
              <p>{route.description}</p>
              <span class="feature-card-bottom"><span>{copy.home.featureCta}</span><span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="manifesto-section" aria-labelledby="manifesto-title">
    <span class="ornament-line" aria-hidden="true">✦</span>
    <p class="eyebrow">{copy.home.manifestoEyebrow}</p>
    <h2 id="manifesto-title">{copy.home.manifestoPrefix} <em>{copy.home.manifestoEmphasis}</em></h2>
    <p>{copy.home.manifestoBody}</p>
    <a class="text-link exn-focusable" href="/guides/">{copy.home.manifestoCta} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
