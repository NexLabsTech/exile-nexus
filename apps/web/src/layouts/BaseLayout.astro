---
import "../styles/site.css";
import "../../../../design/tokens.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { copy, locale } from "../i18n";
import publication from "../data/publication-policy.json";
import { metadataForPage, type PublicationPolicy } from "../lib/seo-policy";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  robots?: "index,follow" | "noindex,nofollow";
}
const { title, description, currentPath = "/", robots = "index,follow" } = Astro.props;
const seo = metadataForPage(publication as PublicationPolicy, currentPath, title, description, robots);
const safeJsonLd = seo.structuredData ? JSON.stringify(seo.structuredData).replace(/</g, "\\u003c") : null;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b0d" />
    <meta name="description" content={description} />
    <meta name="robots" content={seo.robots} />
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {safeJsonLd && <script type="application/ld+json" set:html={safeJsonLd} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Exile Nexus</title>
  </head>
  <body>
    <a class="skip-link exn-focusable" href="#main-content">{copy.common.skipToContent}</a>
    <div class="site-backdrop" aria-hidden="true"></div>
    <SiteHeader currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
