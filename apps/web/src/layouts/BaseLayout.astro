---
import "../styles/site.css";
import "../../../../design/tokens.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  robots?: "index,follow" | "noindex,nofollow";
}
const { title, description, currentPath = "/", robots = "index,follow" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b0d" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Exile Nexus</title>
  </head>
  <body>
    <a class="skip-link exn-focusable" href="#main-content">Skip to content</a>
    <div class="site-backdrop" aria-hidden="true"></div>
    <SiteHeader currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
